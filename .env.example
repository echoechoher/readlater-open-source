HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
READLATER_PASSWORD=
READLATER_SESSION_SECRET=

# Optional OpenAI-compatible translation endpoint.
TRANSLATION_API_KEY=
TRANSLATION_API_URL=https://api.openai.com/v1/chat/completions
TRANSLATION_MODEL=gpt-4o-mini

# Optional server-side Notion defaults. They can also be configured from Setup.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Local digest worker
READLATER_BASE_URL=http://127.0.0.1:3000
READLATER_WORKER_TOKEN=
DIGEST_PROMPT_PATH=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_COMPAT_MODEL=gpt-4o-mini
OPENAI_COMPAT_TIMEOUT_MS=600000
AI_RETRY_COUNT=3
AI_RETRY_DELAY_MS=3000

# Podcast transcription (Alibaba Cloud Tingwu)
TRANSCRIPTION_PROVIDER=tingwu
# Optional: load Tingwu keys from another local app's ignored .env file.
TINGWU_CREDENTIALS_FILE=
TINGWU_ACCESS_KEY_ID=
TINGWU_ACCESS_KEY_SECRET=
TINGWU_APP_KEY=
TINGWU_ENDPOINT=tingwu.cn-beijing.aliyuncs.com
TINGWU_SOURCE_LANGUAGE=cn
TINGWU_DIARIZATION_ENABLED=true
TINGWU_SPEAKER_COUNT=0
TINGWU_POLL_MS=15000
TINGWU_TIMEOUT_MS=30000
TRANSCRIPTION_MAX_DURATION_SECONDS=10800
TRANSCRIPTION_LEASE_MS=120000
